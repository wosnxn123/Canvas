-        final MutableInt savedPearlCount = new MutableInt(0);
-        final Map<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>, List<Pair<UUID, ThrownEnderpearl>>>
