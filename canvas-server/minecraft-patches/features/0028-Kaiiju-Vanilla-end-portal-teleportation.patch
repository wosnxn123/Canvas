Gated behind vanilla-like-experience.vanillaEndPortalTeleportation.

diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index ae0a63be87204337133638e27bf740e846be7d5f..ebbb85a951ab01fda2e6e20abe9d63fe7a85c207 100644
