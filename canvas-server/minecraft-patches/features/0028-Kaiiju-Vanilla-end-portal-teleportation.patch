+                            // Kaiiju start - Vanilla end teleportation (ported, gated)
+                            if (io.canvasmc.canvas.GlobalConfiguration.getInstance().vanillaLikeExperience.vanillaEndPortalTeleportation) {
+                                Vec3 finalPos = this instanceof Player ? Vec3.atBottomCenterOf(targetPos.below()) : Vec3.atBottomCenterOf(targetPos);
