+                            if (io.canvasmc.canvas.GlobalConfiguration.getInstance().vanillaLikeExperience.vanillaEndPortalTeleportation) {
+                                Vec3 finalPos = this instanceof Player ? Vec3.atBottomCenterOf(adjustedSpawn.below()) : Vec3.atBottomCenterOf(adjustedSpawn);
+                                portalInfoCompletable.complete(
