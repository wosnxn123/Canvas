@@ -204,6 +204,11 @@ public final class PaperHooks extends BaseChunkSystemHooks implements PlatformHo
 
     @Override
     public int configMaxAutoSavePerTick(final ServerLevel world) {
+        // Canvas start - vanilla-like experience
