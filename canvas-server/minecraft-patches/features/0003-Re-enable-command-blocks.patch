From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wosnxn123 <wosnxn123@users.noreply.github.com>
Date: Thu, 7 Aug 2026 12:00:00 +0800
Subject: [PATCH] Re-enable command blocks with config gate and global-region execution

Original to this fork: 5 command-block gates routed through
global region execution (GPL-3.0, wosnxn123).

diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index f66b4330ed..9532029f94 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -987,7 +987,7 @@
     public void handleSetCommandBlock(final ServerboundSetCommandBlockPacket packet) {
         PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
         // Canvas start - region threading
-        if (true) {
+        if (!io.canvasmc.canvas.GlobalConfiguration.getInstance().vanillaLikeExperience.commandBlocks) {
             this.player.sendSystemMessage(Component.literal("Command blocks are not enabled with region threading"));
             return;
         }
@@ -1054,7 +1054,7 @@
     public void handleSetCommandMinecart(final ServerboundSetCommandMinecartPacket packet) {
         PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
         // Canvas start - region threading
-        if (true) {
+        if (!io.canvasmc.canvas.GlobalConfiguration.getInstance().vanillaLikeExperience.commandBlocks) {
             this.player.sendSystemMessage(Component.literal("Command block minecarts are not enabled with region threading"));
