Subject: [PATCH] Revert TrapDoorBlock changes form Paper

Ported from Lophine 0121 (MIT, Helvetica Volubi).
Gated behind vanilla-like-experience.revertTrapdoorChanges.

diff --git a/net/minecraft/world/level/block/TrapDoorBlock.java b/net/minecraft/world/level/block/TrapDoorBlock.java
index 614f70a520d13f6fe422ac7e42808c813fb3506d..e25695c07a669c4d8bfe5c7bd13a64d2064f43ec 100644
--- a/net/minecraft/world/level/block/TrapDoorBlock.java
+++ b/net/minecraft/world/level/block/TrapDoorBlock.java
@@ -134,6 +134,13 @@ public class TrapDoorBlock extends HorizontalDirectionalBlock implements SimpleW
                     return;
                 }
                 // Paper end - Call BlockRedstoneEvent
+                // Lophine start - revert Paper trapdoor redstone handling (ported, gated)
+                if (io.canvasmc.canvas.GlobalConfiguration.getInstance().vanillaLikeExperience.revertTrapdoorChanges) {
+                    if (state.getValue(OPEN) != signal) {
+                        state = state.setValue(OPEN, signal);
+                        this.playSound(null, level, pos, signal);
+                    }
+                } else {
                 // Paper start - break redstone on trapdoors early
                 boolean open = state.getValue(TrapDoorBlock.OPEN) != signal;
                 // note: this must run before any state for this block/its neighbours are written to the world
@@ -157,6 +164,8 @@ public class TrapDoorBlock extends HorizontalDirectionalBlock implements SimpleW
                     state = state.setValue(OPEN, signal);
                     this.playSound(null, level, pos, signal);
                 }
+                }
+                // Lophine end
 
                 level.setBlock(pos, state.setValue(POWERED, signal), Block.UPDATE_CLIENTS);
                 if (state.getValue(WATERLOGGED)) {
