+        // Lecithin start - execution provenance for an async event (fd9e884)
+        // An asynchronous event is dispatched on a thread that owns nothing, so a legacy
+        // scheduleSyncDelayedTask from inside one of these listeners has nowhere to go and is
+        // rejected - taking the rest of the listener down with it (measured: EssentialsX's
+        // cancel-afk-on-chat aborted chat formatting and delivery entirely). But the platform is not
+        // in the dark about whose work it is: a PlayerEvent names exactly one player, and Folia's
+        // EntityScheduler is the documented API for scheduling that player's work from any thread.
+        // Establishing that owner for the duration of the dispatch is what lets the legacy call
+        // reach it. Nothing is inferred from the plugin's runnable, the scope is removed in a
+        // finally so a pooled chat thread never carries one player's owner into the next player's
+        // message, and every event with no single player owner still fails closed.
+        final io.canvasmc.canvas.compat.LecithinExecutionProvenance.Owner lecithin$owner =
+            io.canvasmc.canvas.compat.LecithinExecutionProvenance.ownerOfAsyncEvent(event);
+        if (lecithin$owner != null) {
+            io.canvasmc.canvas.compat.LecithinExecutionProvenance.runWithScope(lecithin$owner, () -> this.dispatch(listeners, event));
+            return;
+        }
+        this.dispatch(listeners, event);
+    }
+
+    private void dispatch(RegisteredListener[] listeners, @NotNull Event event) {
+        // Lecithin end - execution provenance for an async event
         for (RegisteredListener registration : listeners) {
